		"better-auth": "^1.7.14"
	},
	"devDependencies": {
		"@app/config": "workspace:*",
		"@cloudflare/workers-types": "^5.20261029.1",
		"auth": "^1.7.14",
		"typescript": "^6.0.2"
	}
