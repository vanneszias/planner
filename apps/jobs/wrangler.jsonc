{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "event-jobs",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// No public URL: reached only through bindings.
	"workers_dev": false,
	"preview_urls": false,
	// Always "eu" when deployed. Local dev clears it (see apps/web/vite.config.ts).
	"vars": {
		"COORDINATOR_JURISDICTION": "eu",
		// The web Worker's origin, for links in poll emails (same as BETTER_AUTH_URL in apps/web).
		"APP_URL": "https://events.zias.be",
		// Sender address; its domain must be onboarded to Email Service (docs/security-privacy.md, "Email").
		"EMAIL_FROM": "noreply@events.zias.be",
		// "queue" sends through Email Service; preview configs switch to "console" (docs/previews.md).
		"EMAIL_DELIVERY": "queue"
	},
	// Email Service. Restricted to the sender domain so no other address can be used.
	"send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@events.zias.be"] }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "event-db",
			"database_id": "3fa4e246-fd9c-4bcd-ae38-d3285b83d627",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "event-files", "jurisdiction": "eu" }],
	"queues": {
		// Poll outcome emails after an automatic decision go back onto the same queue.
		"producers": [{ "binding": "JOBS", "queue": "event-jobs" }],
		"consumers": [
			{ "queue": "event-jobs", "max_retries": 5, "dead_letter_queue": "event-jobs-dlq" }
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "EVENT_COORDINATOR",
				"class_name": "EventCoordinator",
				"script_name": "event-coordinator"
			}
		]
	},
	// Daily at 03:00 UTC: retention cleanup (docs/domain-model.md).
	// Every 15 minutes: automatic poll decisions at their deadline (docs/availability-polls.md).
	"triggers": { "crons": ["0 3 * * *", "*/15 * * * *"] }
}
