{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "event-coordinator",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// No public URL: reached only through bindings.
	"workers_dev": false,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "event-db",
			"database_id": "3fa4e246-fd9c-4bcd-ae38-d3285b83d627",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "event-files", "jurisdiction": "eu" }],
	"durable_objects": {
		"bindings": [{ "name": "EVENT_COORDINATOR", "class_name": "EventCoordinator" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventCoordinator"] }]
}
