{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "event-web",
	"main": "./src/server.ts",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"workers_dev": true,
	"preview_urls": true,
	// Always "eu" when deployed. Local dev clears it (see apps/web/vite.config.ts).
	"vars": {
		"COORDINATOR_JURISDICTION": "eu",
		// Set to the deployed origin per environment.
		"BETTER_AUTH_URL": "https://event-web.zias.workers.dev",
		// "queue" when deployed; "console" only in local dev (sign-in links are printed).
		"EMAIL_DELIVERY": "queue",
		// Public Turnstile site key (invisible widget "event-web"); TURNSTILE_SECRET is a Worker secret.
		"TURNSTILE_SITE_KEY": "0x4AAAAAAFsmjTgiklByDVV2",
		// The api Worker's origin, for export download links.
		"API_URL": "https://event-api.zias.workers.dev"
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "event-db",
			"database_id": "3fa4e246-fd9c-4bcd-ae38-d3285b83d627",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "event-files", "jurisdiction": "eu" }],
	"queues": { "producers": [{ "binding": "JOBS", "queue": "event-jobs" }] },
	// security-privacy.md, "Rate limits". namespace_id is unique per account.
	"ratelimits": [
		{ "name": "LIMIT_REGISTER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "LIMIT_CODE", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
		{ "name": "LIMIT_FIND_EMAIL", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } },
		{ "name": "LIMIT_FIND_IP", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
		{ "name": "LIMIT_BOOKING", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
		{ "name": "LIMIT_RANKING", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
		{ "name": "LIMIT_BULK", "namespace_id": "1007", "simple": { "limit": 5, "period": 60 } },
		{ "name": "LIMIT_LIVE", "namespace_id": "1008", "simple": { "limit": 10, "period": 60 } }
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVENT_COORDINATOR",
				"class_name": "EventCoordinator",
				"script_name": "event-coordinator"
			}
		]
	}
}
