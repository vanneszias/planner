		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.4",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@app/config": "workspace:*",
		"@cloudflare/vite-plugin": "^1.66.0",
