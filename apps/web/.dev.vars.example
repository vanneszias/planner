# Copy to .dev.vars for local development. Never commit .dev.vars.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: Google sign-in only appears when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional locally: Cloudflare's always-pass test secret enables the bot check.
TURNSTILE_SECRET=
# Signs export download links; same value in apps/api/.dev.vars.
EXPORT_SIGNING_KEY=
# Encrypts participant link tokens at rest (passes, D29). Required: registration fails without it.
# Generate with: openssl rand -base64 32
PARTICIPANT_TOKEN_KEY=
